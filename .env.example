# Copy to .env and fill in. Every value except API_KEY is optional.

# Clients send this in the X-API-Key header. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Host port docker-compose publishes the API on.
# PORT=8000

# SQLite by default. In Docker this path is inside the protongen-data volume.
# DATABASE_URL=sqlite:///./data/protongen.db

# VPN Gate source and how long a downloaded list is reused.
# VPNGATE_URL=http://www.vpngate.net/api/iphone/
# VPNGATE_TIMEOUT_SECONDS=30
# SERVER_LIST_TTL_SECONDS=300

# Servers below these thresholds are never handed out.
# MIN_SPEED_BPS=50000000
# MIN_UPTIME_MS=604800000
